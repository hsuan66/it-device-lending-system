<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog 設定：把 log 寫成檔案，每天一個檔，保留 30 天
  * all-日期.log：全部的 log（含 ASP.NET Core 框架）
  * own-日期.log：只有本專案（DeviceLending.*）的 log，排查問題先看這個
  要記哪些等級由 appsettings.json（正式環境）、appsettings.Development.json（開發）的 Logging:LogLevel 決定，
  這裡只負責「寫到哪裡、長什麼樣子」
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <!--
    log 資料夾：appsettings.json 的 LogDirectory，沒設定或空白時用執行目錄下的 logs（例如 bin/Debug/net10.0/logs）
    不寫死絕對路徑，Windows、macOS、Linux 都能直接執行
  -->
  <variable name="logDirectory" value="${configsetting:item=LogDirectory:whenEmpty=${basedir}/logs}" />

  <!-- 時間|等級|類別|訊息（有例外時接著印出完整的例外與堆疊） -->
  <variable name="lineLayout" value="${longdate}|${level:uppercase=true}|${logger}|${message:withexception=true}" />

  <targets>
    <target xsi:type="File" name="allFile"
            fileName="${var:logDirectory}/all-${shortdate}.log"
            layout="${var:lineLayout}"
            encoding="utf-8"
            maxArchiveDays="30" />

    <target xsi:type="File" name="ownFile"
            fileName="${var:logDirectory}/own-${shortdate}.log"
            layout="${var:lineLayout}"
            encoding="utf-8"
            maxArchiveDays="30" />
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="allFile" />
    <logger name="DeviceLending.*" minlevel="Trace" writeTo="ownFile" />
  </rules>
</nlog>
